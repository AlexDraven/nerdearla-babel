# Copiar a .env y ajustar según el despliegue.

# CSV de salas a levantar simultáneamente. Por defecto: 2 de demo con audio
# pregrabado (main, room2) + 1 dedicada a que alguien hable a su propio
# micrófono (mic, ver frontend/mic/) — agregar más ids para escalar (ver
# docs/SCALING.md).
BABEL_ROOM_IDS=main,room2,mic

# ids (de los de arriba) que fuerzan modo micrófono en vivo sin importar
# BABEL_INGEST_PROTOCOL — reciben audio de frontend/mic/ vía /ws/mic/{id}.
BABEL_MIC_ROOM_IDS=mic

# Modelo Gemma a usar (debe estar pulleado en Ollama). gemma4:e2b = liviano
# y rápido; gemma4:e4b = mayor calidad, más lento.
OLLAMA_MODEL=gemma4:e2b
BABEL_OLLAMA_BASE_URL=http://ollama:11434/v1
BABEL_OLLAMA_MODEL=gemma4:e2b

# Idioma al que se traduce todo lo que no esté ya en ese idioma (es|en).
BABEL_TARGET_LANG=es

# "file"  -> cada sala ingiere en loop tests/fixtures/<room_id>.wav (o el
#            fixture de ejemplo si no existe ese archivo) — demo sin pasos
#            manuales, ideal para probar el proyecto clonándolo y corriendo.
# "rtmp"  -> cada sala escucha un push real de OBS/consola en su puerto
#            (BABEL_INGEST_BASE_PORT + índice de la sala).
BABEL_INGEST_PROTOCOL=file
BABEL_INGEST_HOST=0.0.0.0
BABEL_INGEST_BASE_PORT=1935
BABEL_CHUNK_SECONDS=4

BABEL_MAX_QUEUE_SIZE=2
BABEL_CONCURRENT_INFERENCE_WORKERS=1
BABEL_INFERENCE_TIMEOUT_SECONDS=30

# Glosario global (fallback). Cada sala puede tener el suyo propio en
# glossaries/<room_id>.yaml — si existe, tiene prioridad sobre este.
BABEL_GLOSSARY_PATH=/app/glossaries/example-charla-kubernetes.yaml
BABEL_GLOSSARY_INLINE_THRESHOLD=40

BABEL_LOG_LEVEL=INFO
